PIXEL_PASSWORD=change-me
# Private address the dashboard listens on, e.g. this host's Tailscale IP.
PIXEL_HOST=127.0.0.1
PIXEL_PORT=7700
# Used for links in notifications.
PIXEL_PUBLIC_URL=http://pixel-host:7700
# Hostname/IP of the pixel host as seen from your machine (for `opencode attach` commands);
# agent VM addresses are only reachable through the pixel host (e.g. Tailscale subnet route or SSH tunnel).
PIXEL_PUBLIC_HOST=
